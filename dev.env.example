# Copy this file to dev.env (Docker Compose) and local.env (./dev.sh) and fill in your own values.
# Secrets are left blank on purpose. Use long random strings for the JWT and ENC secrets.

NODE_ENV=development
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
REDIS_URL=redis://redis:6379
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
USER_JWT_SECRET=
DRIVER_JWT_SECRET=
ADMIN_JWT_SECRET=
OTHER_SECRET=
IN_APP_SECRET=
OTHER_SECRET_EXP_IN_SEC=50
ENC_SECRET=
COMMON_SERVICE_URL=http://common-service:3004/common-apis
USER_SERVICE_URL=http://user-service:3002/user-apis
DRIVER_SERVICE_URL=http://driver-service:3001/driver-apis
ADMIN_SERVICE_URL=http://admin-service:3005/admin-apis
RIDE_SERVICE_URL=http://ride-service:3006/ride-apis
VEHICLE_SERVICE_URL=http://ride-service:3006/vehicle-apis
NOTIFICATION_SERVICE_URL=http://notification-service:3003/notification-apis
HELPERDESK_SERVICE_URL=http://helperdesk-service:3009/helperdesk-apis
SOCKET_SERVICE_URL=http://socket-service:8000/socket-apis
